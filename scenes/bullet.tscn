[sub_resource type="Shader" id="Shader_plasma_beam"]
code = "shader_type spatial;
render_mode blend_add, cull_disabled, unshaded, depth_draw_never;

// Plasma bolt AAA: nucleo branco-quente HDR + corpo ciano eletrico.
// Gradiente axial afila as pontas, energia animada percorre o feixe
// e um flicker sutil da vida ao tiro. Cores > 1.0 alimentam o bloom (glow HDR).
uniform vec4 core_color : source_color = vec4(3.2, 4.6, 6.0, 1.0);
uniform vec4 edge_color : source_color = vec4(0.25, 1.1, 3.2, 1.0);
uniform float energy_speed : hint_range(0.0, 60.0) = 18.0;
uniform float energy_scale : hint_range(0.1, 20.0) = 4.0;
uniform float flicker_strength : hint_range(0.0, 1.0) = 0.22;

varying float v_axial;
varying float v_angle;

void vertex() {
	// Capsula ao longo de Y (espaco do mesh): |y| em [0, 1] da base ao topo.
	v_axial = clamp(abs(VERTEX.y) * 2.0, 0.0, 1.0);
	v_angle = atan(VERTEX.x, VERTEX.z);
}

void fragment() {
	// Pontas afiladas: brilho morre suavemente nas extremidades do feixe.
	float taper = smoothstep(1.0, 0.62, v_axial);
	float tip = smoothstep(1.0, 0.88, v_axial);

	// Energia percorrendo o eixo do tiro (scroll) + ondulacao transversal.
	float flow = sin((UV.y * 6.2831 - TIME * energy_speed) + v_angle * 2.0) * 0.5 + 0.5;
	float energy = 0.65 + 0.35 * pow(flow, 1.5);

	// Flicker organico (plasma instavel).
	float flicker = 1.0 - flicker_strength * (0.5 + 0.5 * sin(TIME * 47.0 + v_angle * 3.0) * sin(TIME * 31.0));

	vec3 col = mix(core_color.rgb, edge_color.rgb, pow(tip, 0.6));
	col += edge_color.rgb * energy * 0.6;
	col *= energy * flicker * taper;
	col += core_color.rgb * 1.2 * tip; // pico superexposto na ponta

	ALBEDO = col;
	ALPHA = clamp(max(taper, tip) * flicker, 0.0, 1.0);
}
"

